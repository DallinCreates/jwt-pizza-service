                      "version": "v0",
                      "datasource": {
                        "name": "grafanacloud-logs"
                      },
                      "spec": {
                        "direction": "backward",
                        "editorMode": "builder",
                        "expr": "{source=\"jwt-pizza-service\"} | json auth=\"authorized\", method=\"method\", status=\"statusCode\", path=\"path\", req=\"reqBody\", res=\"resBody\", sql=\"sql\", user=\"user.email\", error=\"message\"",

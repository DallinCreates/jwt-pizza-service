        "spec": {
          "id": 1,
          "title": "Logs",
          "description": "Every HTTP, database, factory and exception log from the JWT Pizza service. Click a cell to see its full value.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",

                        "queryType": "range"
                      }
                    },
                    "refId": "A",
                    "hidden": false
                  }
                }
              ],
              "transformations": [
                {
                  "kind": "Transformation",
                  "group": "extractFields",
                  "spec": {
                    "options": {
                      "format": "json",
                      "keepTime": true,
                      "replace": false,
                      "source": "labels"
                    }
                  }
                },
                {
                  "kind": "Transformation",
                  "group": "organize",
                  "spec": {
                    "options": {
                      "excludeByName": {
                        "Line": true,
                        "detected_level": true,
                        "id": true,
                        "labels": true,
                        "service_name": true,
                        "source": true,
                        "tsNs": true
                      },
                      "indexByName": {
                        "Time": 0,
                        "auth": 3,
                        "error": 11,
                        "level": 1,
                        "method": 4,
                        "path": 6,
                        "req": 7,
                        "res": 8,
                        "sql": 9,
                        "status": 5,
                        "type": 2,
                        "user": 10
                      },
                      "renameByName": {}
                    }
                  }
                }
              ],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "table",
            "version": "13.4.0-42565191035",
            "spec": {
              "options": {
                "cellHeight": "sm",
                "showHeader": true,
                "sortBy": [
                  {
                    "desc": true,
                    "displayName": "Time"
                  }
                ],
                "zebraStriping": false
              },
              "fieldConfig": {
                "defaults": {
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "value": 0,
                        "color": "green"
                      },
                      {
                        "value": 80,
                        "color": "red"
                      }
                    ]
                  },
                  "custom": {
                    "align": "auto",
